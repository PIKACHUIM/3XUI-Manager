# Vercel / Node container / EdgeOne Node function
# Use one storage backend per deployment.
ADMIN_BOOTSTRAP_TOKEN=
APP_ENCRYPTION_KEY=
CRON_SECRET=
APP_NAME=3XUI Manager

# Vercel / Node: remote MySQL document store (mysql2)
STORAGE_DRIVER=mysql
MYSQL_URLS=mysql://user:pass@host:3306/manager
# Or separate fields:
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASS=
# MYSQL_NAME=

# EdgeOne / ESA edge runtime: Blob or KV
# STORAGE_DRIVER=blob
# EO_BLOB_NAMESPACE=default
# ESA_BLOB / ESA_KV / EO_KV are platform bindings, not plain dotenv values.
