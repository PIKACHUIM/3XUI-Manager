{
  "name": "3xui-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vercel": "vite build --config vite.vercel.config.ts",
    "build:edgeone": "vite build --config vite.edgeone.config.ts && node scripts/build-edgeone.mjs",
    "build:esa": "vite build --config vite.esa.config.ts && node scripts/build-esa.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply 3xuiwork-data --local",
    "db:remote": "wrangler d1 migrations apply 3xuiwork-data --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@edgeone/pages-blob": "^0.0.19",
    "hono": "^4.12.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260722.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.11.0"
  }
}
